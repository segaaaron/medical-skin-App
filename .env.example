# Copia a .env y ajusta. .env no se sube al repositorio.
NODE_ENV=development
PORT=3000

# La API usa el usuario de aplicación, nunca el dueño del esquema:
# RLS no se aplica al dueño ni a un superusuario.
DATABASE_URL=postgresql://medskin:dev_local_only@localhost:5433/medskin
DATABASE_URL_OWNER=postgresql://medskin_owner:dev_local_only@localhost:5433/medskin

# La aplicación puede ir por el pooler (modo transacción, como en producción).
# Las migraciones NUNCA: van directas al dueño del esquema.
DATABASE_URL_POOLER=postgresql://medskin:dev_local_only@localhost:6432/medskin

REDIS_URL=redis://localhost:6380

S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_BUCKET=medskin-dev
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=test
S3_SECRET_KEY=test

# Correo. En desarrollo lo atrapa Mailpit: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
CORREO_REMITENTE=no-responder@medskin.local

# Secretos reales: fuera del repositorio, siempre.
JWT_PRIVATE_KEY_PATH=./.secrets/jwt.key
JWT_PUBLIC_KEY_PATH=./.secrets/jwt.pub

# El token de la consola interna lo firma el SERVICIO DE PLATAFORMA, fuera de la región, con
# su propio par de llaves y su propio `kid` (`plataforma-acceso.md`). Aquí solo vive la
# PÚBLICA: este proceso verifica, nunca firma un token de consola.
# La privada es solo de desarrollo —el servicio que firma no corre en tu máquina— y se genera
# sola al arrancar. En producción NO se pone.
PLATFORM_JWT_PUBLIC_KEY_PATH=./.secrets/plataforma.pub
PLATFORM_JWT_PRIVATE_KEY_PATH=./.secrets/plataforma.key

# La región del despliegue (§7.4). `REGION_ETIQUETA` sale de la configuración y no de la
# base: todos los inquilinos de un despliegue comparten la etiqueta (decisión 6).
# `ZONA_HORARIA` es para las frases con hora («Puedes volver a entrar a las 10:29»).
REGION=latam
REGION_ETIQUETA=Bolivia · bo-1
ZONA_HORARIA=America/La_Paz
# El plazo legal de conservación del expediente, en años (`cuentas.md` · DELETE
# /v1/cuentas/mia, decisión del 28 de octubre). Es configuración del despliegue, no una
# tabla: todos los inquilinos de la región comparten el plazo. El número por país sigue
# siendo decisión abierta del diseño (§16.7); de dónde sale, no.
CONSERVACION_ANOS=7

# La llave del servicio: HMAC de los correos en las claves de Redis y resumen de los
# refrescos. 32 bytes mínimo. En producción la pone el servicio de llaves, nunca el repo.
SERVICE_HMAC_KEY=dev_only_hmac_key_32_bytes_minimo_aqui

# CORS cerrado: lista vacía no abre ningún origen. Las dos apps nativas no mandan `Origin`.
CORS_ORIGENES=

# El peso de una ficha en disco, en MB, para el `almacenamiento_limite` de `GET /v1/plan`.
# Sale de aquí y no de una constante: depende de lo que la app reduzca antes de subir y de si
# la maestra se recomprime. Por omisión 450 (120 fotos × ~3,7 MB, `servicios.md` §6.1).
ALMACENAMIENTO_POR_FICHA_MB=450

# LOS AVISOS · APNs para iOS y FCM para Android. VACÍOS en desarrollo a propósito: sin
# credencial no se construye el remitente y la bandeja de salida acumula los avisos en vez de
# gastar sus tres intentos contra un canal que no existe. El `.p8` de Apple y el JSON de la
# cuenta de servicio de Google son secretos: en producción los pone el servicio de llaves.
# APNS_KEY_PATH=.secrets/apns.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=com.medskin.app
# `api.sandbox.push.apple.com` hasta que la app esté en la tienda.
APNS_HOST=api.sandbox.push.apple.com
# FCM_CUENTA_SERVICIO_PATH=.secrets/fcm.json

# LA VENTANA DE ROTACIÓN de la llave de la consola: rutas separadas por coma de llaves
# públicas que TAMBIÉN se aceptan. Vacío fuera de una rotación.
# PLATFORM_JWT_PUBLIC_KEYS_EXTRA=
