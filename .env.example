# Copia a .env y ajusta. .env no se sube al repositorio.
NODE_ENV=development
PORT=3000

# La API usa el usuario de aplicación, nunca el dueño del esquema:
# RLS no se aplica al dueño ni a un superusuario.
DATABASE_URL=postgresql://medskin:dev_local_only@localhost:5433/medskin
DATABASE_URL_OWNER=postgresql://medskin_owner:dev_local_only@localhost:5433/medskin

# La aplicación puede ir por el pooler (modo transacción, como en producción).
# Las migraciones NUNCA: van directas al dueño del esquema.
DATABASE_URL_POOLER=postgresql://medskin:dev_local_only@localhost:6432/medskin

REDIS_URL=redis://localhost:6380

S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_BUCKET=medskin-dev
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=test
S3_SECRET_KEY=test

# Correo. En desarrollo lo atrapa Mailpit: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
CORREO_REMITENTE=no-responder@medskin.local

# Secretos reales: fuera del repositorio, siempre.
JWT_PRIVATE_KEY_PATH=./.secrets/jwt.key
JWT_PUBLIC_KEY_PATH=./.secrets/jwt.pub
